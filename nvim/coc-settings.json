{
    "coc.preferences.formatOnSave": true,
    "coc.preferences.formatOnSaveFiletypes": ["typescript", "typescriptreact", "php", "toml", "sql", "go"],
    "coc.preferences.hoverTarget": "float",


    "prettier.ignoreConfig": true,
    "prettier.singleQuote": true,
    "prettier.trailingComma": "all",
    "eslint.enable": false,
    "typescript.format.enable": false,


    "intelephense.environment.phpVersion": "7.3",

    "html.filetypes": [
        "html",
        "handlebars",
        "htmldjango",
        "blade"
    ],

    "Lua.diagnostics.globals" : ["vim"],

    "go.goplsPath": "~/.config/coc/extensions/coc-go-data/bin/gopls",
    "go.goplsOptions": {
      "completeUnimported": true
    }
}
